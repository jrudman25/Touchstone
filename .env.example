# Copy this file to .env and fill in your own values. Every value below is a
# placeholder — replace each "replace-me" before real use. .env is git-ignored.
#
# Two consumers read .env; no python-dotenv dependency is used:
#   - `docker compose` reads .env automatically for ${VAR} interpolation.
#   - Native services load it explicitly via `uv run --env-file .env <command>`.

# PostgreSQL (Compose store; native services connect at this host/port)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=touchstone
POSTGRES_USER=touchstone
POSTGRES_PASSWORD=replace-me-local-password

# MongoDB (Compose store)
MONGO_URL=mongodb://localhost:27017
MONGO_DB=touchstone

# Redis (Compose store: job queue and run event streams)
REDIS_URL=redis://localhost:6379/0

# FastAPI -> Django base URL for service-to-service calls (native dev)
RECORDS_BASE_URL=http://localhost:8000

# RS256 JWT keypair paths (generate with: uv run python scripts/generate_dev_keys.py)
JWT_PRIVATE_KEY_PATH=.secrets/jwt/private.pem
JWT_PUBLIC_KEY_PATH=.secrets/jwt/public.pem

# Django
DJANGO_SECRET_KEY=replace-me-django-secret-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Refresh cookie: set Secure=false only if serving over plain HTTP off localhost
AUTH_COOKIE_SECURE=true

# Browser-facing origins allowed to POST to Django admin (CSRF)
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8080

# seed_dev superuser credentials (local development only)
DEV_SUPERUSER_USERNAME=replace-me-admin
DEV_SUPERUSER_PASSWORD=replace-me-admin-password
